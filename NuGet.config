<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local package source. The machine's global NuGet.Config declares no sources,
  which makes restore fail with NU1100; this keeps the fix scoped to the repository
  instead of changing user-wide configuration.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
